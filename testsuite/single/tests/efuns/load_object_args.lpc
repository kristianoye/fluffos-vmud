// load_object() supports optional trailing constructor args, forwarded to
// create() exactly once -- when this call is the one that actually loads
// the object. A later load_object() on an already-loaded object must not
// re-invoke create(), so any args passed then are silently dropped.
void do_tests() {
  object ob, ob2;

  ob = load_object("/clone/load_object_ctor_args", "hello", 42);
  ASSERT(objectp(ob));
  ASSERT_EQ(1, ob->query_create_count());
  ASSERT_EQ(({"hello", 42}), ob->query_ctor_args());

  ob2 = load_object("/clone/load_object_ctor_args", "ignored");
  ASSERT(ob2 == ob);
  ASSERT_EQ(1, ob2->query_create_count());
  ASSERT_EQ(({"hello", 42}), ob2->query_ctor_args());

  // Plain load_object() with no extra args must still work.
  ASSERT(objectp(load_object("/clone/testob1")));
}
